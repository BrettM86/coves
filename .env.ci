# Coves hermetic CI environment.
#
# This mirrors .env.dev almost verbatim, and that is deliberate. Every service
# in docker-compose.ci.yml shares one network namespace, so the CI stack has the
# same loopback topology the dev stack has on your host:
#
#   PDS 3001 | PLC 3002 | AppView 8081 | Postgres 5435 (appview) / 5434 (test) / 5436 (plc)
#
# Keeping those ports identical is what lets the test suite's endpoint defaults
# (testkit.Endpoints() in tests/testkit/testkit.go, which is the only place a
# base URL is constructed) resolve to the CI stack without editing a single test. It also means CI config cannot quietly
# drift away from dev config.
#
# Lines that differ from .env.dev are marked "CI:" with the reason.
#
# NOTE: like .env.dev, this file is intentionally tracked. Every credential in
# it is namespace-local throwaway state that holds no real accounts or data.
# Production secrets live in .env.prod, which is gitignored.

# =============================================================================
# PostgreSQL — AppView database
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=coves_dev
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password

# CI: set explicitly. internal/config defaults to exactly this string, but a
# gate should not depend on a default staying put.
DATABASE_URL=postgres://dev_user:dev_password@localhost:5435/coves_dev?sslmode=disable

# =============================================================================
# PostgreSQL — test database (read by tests/testkit; T1 integration tier)
# =============================================================================
POSTGRES_TEST_DB=coves_test
POSTGRES_TEST_USER=test_user
POSTGRES_TEST_PASSWORD=test_password
POSTGRES_TEST_PORT=5434

# CI: set explicitly. The 21 read sites all fall back to this exact URL when
# unset — which is what happens on a developer's machine — so making it
# explicit here removes a silent dependency on that fallback.
TEST_DATABASE_URL=postgres://test_user:test_password@localhost:5434/coves_test?sslmode=disable

# =============================================================================
# PDS
# =============================================================================
PDS_HOSTNAME=localhost
PDS_PORT=3001
PDS_SERVICE_ENDPOINT=http://localhost:3000
PDS_JWT_SECRET=local-dev-jwt-secret-change-in-production
PDS_ADMIN_PASSWORD=admin
PDS_SERVICE_HANDLE_DOMAINS=.local.coves.dev,.coves.social
PDS_PLC_ROTATION_KEY=af514fb84c4356241deed29feb392d1ee359f99c05a7b8f7bff2e5f2614f64b2
PDS_URL=http://localhost:3001

# CI: .env.dev uses the container DNS name (http://plc-directory:3000) because
# the dev PDS reaches PLC across a bridge network. In the shared CI namespace
# there are no peer DNS names — PLC is on loopback at its host-equivalent port.
PDS_DID_PLC_URL=http://localhost:3002

# The AppView authenticates to the PDS as this account to write community
# records. scripts/ci.sh creates it after the PDS is healthy: unlike the dev
# stack, whose PDS volume persists and already holds this account, CI starts
# from an empty PDS every run.
PDS_INSTANCE_HANDLE=testuser123.local.coves.dev
PDS_INSTANCE_PASSWORD=test-password-123

# =============================================================================
# The federated PDS and the relay (CI only — no dev-stack equivalent)
# =============================================================================
# docker-compose.ci.yml's header explains the topology. These variables are
# read by TESTS (tests/testkit's EndpointSet) and by scripts/ci-bootstrap.sh,
# never by the AppView: it has no configuration naming pds2, and that is the
# point — everything it learns about a pds2-hosted repo, it learns by resolving
# a DID against the PLC and following the service endpoint in the DID document.
PDS2_URL=http://localhost:3011
PDS2_SERVICE_HANDLE_DOMAINS=.pds2.test

# Used by scripts/ci-bootstrap.sh to announce both PDSes, and by
# scripts/lib/runner-ready.sh to verify the relay is actually crawling them.
# Kept in step with docker-compose.ci.yml's RELAY_ADMIN_KEY.
RELAY_URL=http://localhost:2470
RELAY_ADMIN_KEY=ci-relay-admin-key

# =============================================================================
# Bot-Protected Signup (Cloudflare Turnstile)
# =============================================================================
# Cloudflare's published always-pass test keys: any token verifies as success,
# so signup tests need no solved widget.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# CI: absent from .env.dev. The CI network is `internal: true`, so the AppView
# cannot reach challenges.cloudflare.com — the turnstile-stub service answers
# {"success":true} in its place, which is what the always-pass secret above
# produces upstream anyway. internal/config reads this only when IS_DEV_ENV is
# true, so it can never redirect production's captcha check.
TURNSTILE_SITEVERIFY_URL=http://127.0.0.1:3003/turnstile/v0/siteverify

# =============================================================================
# AppView
# =============================================================================
APPVIEW_PORT=8081
PORT=8081
APPVIEW_PUBLIC_URL=http://127.0.0.1:8081
FIREHOSE_URL=ws://localhost:3001/xrpc/com.atproto.sync.subscribeRepos
JETSTREAM_FEEDS=self=ws://localhost:6008

# =============================================================================
# Identity / PLC
# =============================================================================
IDENTITY_CACHE_TTL=24h
PLC_DIRECTORY_URL=http://localhost:3002

# HANDLE_WELL_KNOWN_HOSTS makes handle verification work with no DNS and no
# TLS. indigo verifies a DID's declared handle by fetching
# https://<handle>/.well-known/atproto-did; here that GET is sent to the PDS
# that mints the suffix instead, with the handle in the Host header — the same
# trial-host trick the relay uses (HANDLE_RESOLVER_HOSTS in
# docker-compose.ci.yml). The bidirectional check is unchanged; only the address
# is. Dev/CI only: config refuses it unless IS_DEV_ENV=true, and it must never
# be set in production. Suffixes must start with a dot.
HANDLE_WELL_KNOWN_HOSTS=.local.coves.dev=localhost:3001,.coves.social=localhost:3001,.pds2.test=localhost:3011

# =============================================================================
# OAuth
# =============================================================================
OAUTH_PRIVATE_JWK={"alg":"ES256","crv":"P-256","d":"9tCMceYSgyZfO5KYOCm3rWEhXLqq2l4LjP7-PJtJKyk","kid":"oauth-client-key","kty":"EC","use":"sig","x":"EOYWEgZ2d-smTO6jh0f-9B7YSFYdlrvlryjuXTCrOjE","y":"_FR2jBcWNxoJl5cd1eq9sYtAs33No9AVtd42UyyWYi4"}
OAUTH_COOKIE_SECRET=f1132c01b1a625a865c6c455a75ee793572cedb059cebe0c4c1ae4c446598f7d
OAUTH_SEAL_SECRET=AW0U2uzDzrS0zI3OeZXvsWXbmw5UwebmDtXtQwDYKMs=

# ENCRYPTION_KEY seals stored credentials (community PDS passwords/tokens,
# aggregator OAuth sessions) with AES-256-GCM in the AppView process. Dev/CI
# only: unset in dev generates a random key per boot, which strands every
# stored credential at the next restart, so pin one here. Never reuse in prod.
ENCRYPTION_KEY=s+mOXSpNxojVEVj1IgVYrWBYxqbifw8WTBMn7BSsSdc=
OAUTH_CLIENT_PRIVATE_KEY=z42ti3ZG2JDj4RvFKdovxbgHB9Q4uvwsPvew8NQaxKxdfTLY
OAUTH_CLIENT_KEY_ID=coves-key-1770360581

# =============================================================================
# Instance / aggregators
# =============================================================================
# Kept identical to .env.dev. These did:plc values were minted in the dev PLC
# and do not exist in CI's fresh PLC, which is correct: internal/core/posts
# only string-matches them to bypass the community authorization check, so an
# absent DID means "not trusted" rather than a broken lookup.
TRUSTED_AGGREGATOR_DIDS=did:plc:yyf34padpfjknejyutxtionr,did:plc:igjbg5cex7poojsniebvmafb,did:plc:jn4tlbpkdms5tahfrylct5g7

# =============================================================================
# Dev-mode switches (identical to .env.dev)
# =============================================================================
ENV=development
NODE_ENV=development
IS_DEV_ENV=true
SKIP_DID_WEB_VERIFICATION=true
AUTH_SKIP_VERIFY=true

# =============================================================================
# Logging
# =============================================================================
# CI: quiet by default so the go test -json stream stays readable.
# docker-compose.ci.yml re-enables logging for the AppView container
# specifically, where the logs are the only way to diagnose a failing E2E test.
LOG_LEVEL=debug
LOG_ENABLED=false

# =============================================================================
# Image proxy
# =============================================================================
IMAGE_PROXY_ENABLED=true
IMAGE_PROXY_BASE_URL=http://127.0.0.1:8081
# CI: .env.dev uses the relative path ./cache/images. The runner mounts the
# repository at /src, so a relative cache path would have tests writing image
# blobs into the working tree. An absolute tmp path keeps the checkout clean.
IMAGE_PROXY_CACHE_PATH=/tmp/coves-image-cache
IMAGE_PROXY_CACHE_MAX_GB=5
IMAGE_PROXY_FETCH_TIMEOUT_SECONDS=30
IMAGE_PROXY_MAX_SOURCE_SIZE_MB=10
IMAGE_PROXY_MAX_SOURCE_MEGAPIXELS=50
IMAGE_PROXY_MAX_CONCURRENT_PROCESSES=4
IMAGE_PROXY_MAX_IN_FLIGHT_REQUESTS=64

# =============================================================================
# Observability
# =============================================================================
OTEL_ENABLED=false

# =============================================================================
# Acceptance queue
# =============================================================================
# CI: absent from .env.dev, which takes the 1m default. The pipeline tier's
# per-probe budget is 45 seconds, so a minute-long cadence means a contract that
# ever needed the driver would time out before its first pass — and would do it
# as a flake rather than as a failure that names the driver. Two seconds keeps
# the pass inside every probe window.
#
# No contract currently DRIVES the engine — no community in the pipeline tier
# holds credentials in the AppView, so the backlog query correctly returns
# nothing — which makes this a liveness setting rather than a functional one:
# the driver runs, against the real database, on every CI boot.
ACCEPTANCE_QUEUE_INTERVAL=2s

# =============================================================================
# Dead letter redriver
# =============================================================================
# CI: the vote ordering contract has to OBSERVE dead-letter recovery — a vote
# refused for arriving before its subject is only recovered by a redrive — and
# the pipeline tier's per-probe budget is 45 seconds, which the 5m default
# blows through on the first pass. At 5s the 10 attempts MaxRedriveAttempts
# allows span 50s, so the probe budget expires before the attempts do and a
# failure names the contract rather than the retry ceiling.
REDRIVE_INTERVAL=5s
