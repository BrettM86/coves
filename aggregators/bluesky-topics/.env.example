# Bluesky Topics Aggregator environment. Copy to .env and fill in.

# Coves aggregator API key (required unless DRY_RUN=1)
COVES_API_KEY=ckapi_your_api_key_here

# Classifier credentials (required). The classifier speaks the Anthropic Messages
# API; point it at OpenRouter to use non-Anthropic models:
ANTHROPIC_API_KEY=sk-or-v1-your_openrouter_key_here
ANTHROPIC_BASE_URL=https://openrouter.ai/api
# Or use the Anthropic API directly: ANTHROPIC_API_KEY=sk-ant-... and no ANTHROPIC_BASE_URL.

# Optional overrides
# COVES_API_URL=https://coves.social
# BLUESKY_API_URL=https://public.api.bsky.app
# CONFIG_PATH=config.yaml
# STATE_FILE=data/state.json
# RUN_ON_STARTUP=false

# Set to 1 to collect and classify without posting or touching state.
# DRY_RUN=0
